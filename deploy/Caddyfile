# DOMAIN 是真实域名时 Caddy 会自动申请并续期 HTTPS 证书；
# 不设置时是 localhost，用自签证书，方便在本机试。
{$DOMAIN:localhost} {
	encode zstd gzip

	# 接口和 WebSocket 转给游戏服务，其余都是前端静态文件
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		# 前端路由（/room/123456 这类地址）刷新时回到 index.html
		try_files {path} /index.html
		file_server
	}

	# 带哈希的静态资源可以长期缓存
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
